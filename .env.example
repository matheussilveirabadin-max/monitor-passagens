# Só para rodar no seu computador. No GitHub, use os Secrets com estes mesmos nomes.
# Copie para .env e preencha. O .env não vai para o git.
#
# Senha de app do Gmail (não é a sua senha normal):
#   1. Ative a verificação em duas etapas na conta Google
#   2. Acesse https://myaccount.google.com/apppasswords e crie uma senha
#   3. Cole os 16 caracteres abaixo (com ou sem espaços)

EMAIL_FROM=seu_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=seu_email@gmail.com

# Alternativa: qualquer URL do Apprise (Telegram, ntfy, outro SMTP...), ignora as linhas acima
# APPRISE_URL=
